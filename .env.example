RCON_HOST=your.rust.server
RCON_PORT=28152
RCON_PASS=change-me
ANTHROPIC_API_KEY=
DATA_DIR=/data

# Optional Discord notifications
DISCORD_WEBHOOK=
DISCORD_VOICE_WEBHOOK=
DISCORD_RECORDINGS_WEBHOOK=
# Separate prison channels; set BOTH webhook variables OR a bot token below.
DISCORD_VIP_LOG_WEBHOOK=
DISCORD_OWNER_LOG_WEBHOOK=
# Optional alternative to webhook URLs: bot token and channel IDs.
DISCORD_BOT_TOKEN=
DISCORD_VIP_CHANNEL_ID=1558442485364293682
DISCORD_OWNER_CHANNEL_ID=1558850603533213867
# Legacy, not used for owner/VIP prison delivery to avoid accidental reason leaks.
DISCORD_PRISON_LOG_WEBHOOK=
DISCORD_HISTORY_WEBHOOK=

# Optional legacy history import
GITHUB_TOKEN=
GITHUB_REPO=ctugwell01/5Heads-arena
GITHUB_PATH=prison_history_arena.json

# FiveHeads AI Manager / Carbon bridge
# AI_BRIDGE_SECRET must exactly match "API Secret" in FiveHeadsAIBridge.json on Rust.
AI_BRIDGE_SERVER_ID=5heads-arena-main
AI_BRIDGE_SECRET=
# Protects Railway-only admin command/audit endpoints; do NOT put this token in Carbon.
AI_ADMIN_TOKEN=
AI_BRIDGE_CLOCK_SKEW_SECONDS=60
